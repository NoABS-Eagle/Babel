__pycache__/
*.pyc

# Runtime session cache (babel/app.py) — regenerated per session, not source
babel/.session.3d/
babel/.session.ir.xml
babel/.session.src

# Downloaded at first run by _ensure_3d_assets() in babel/app.py
babel/static/occt-import-js.js
babel/static/occt-import-js.wasm

# Third-party installer, unrelated to source
accessdatabaseengine_X64.exe

# Eagle editor auto-backup files (.l#1, .l#2, .s#1, ...)
*.l#*
*.s#*
*.b#*

# KiCad local-history plugin artifacts (embedded git repos, break `git add`)
.history/

# KiCad lock files
~*.lck
*.lck

# Test-run output (regenerated each run — feedback_outputs_dir)
outputs/

# Not tracked for now (2026-07-19, user decision) — real test fixtures will
# come later as a curated usage example; until then this is scratch/dump
# material, not source.
testData/
