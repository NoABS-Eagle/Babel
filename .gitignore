accessdatabaseengine_X64.exe

# Generated exporter output (regenerate via babel/altium_exporter.py etc.)
testData/out/

# Eagle editor auto-backup files (.l#1, .l#2, .s#1, ...)
*.l#*
*.s#*
*.b#*
